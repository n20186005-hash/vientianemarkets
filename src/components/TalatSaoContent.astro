---
import { useTranslations } from '../i18n/ui';
import MapSection from './MapSection.astro';
import Reviews from './Reviews.astro';

interface Props {
  lang: 'lo' | 'en' | 'zh' | 'th';
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const k = 'ts';
const faqs = Object.values(t(`${k}.faq`) as unknown as Record<string, { q: string; a: string }>);
---

<div class="mx-auto max-w-3xl space-y-12 px-4 py-12">

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t(`${k}.atAGlanceTitle`)}</h2>
    <p class="mt-3 text-zinc-700">{t(`${k}.atAGlanceBody`)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t(`${k}.openingHoursTitle`)}</h2>
    <p class="mt-3 text-zinc-700">{t(`${k}.openingHoursBody`)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t(`${k}.whatToBuyTitle`)}</h2>
    <p class="mt-3 text-zinc-700">{t(`${k}.whatToBuyBody`)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t('history.textile.title')}</h2>
    <p class="mt-3 text-zinc-700">{t('history.textile.desc')}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t('history.etiquette.title')}</h2>
    <p class="mt-3 text-zinc-700">{t('history.etiquette.desc')}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t(`${k}.souvenirsTitle`)}</h2>
    <p class="mt-3 text-zinc-700">{t(`${k}.souvenirsBody`)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t(`${k}.moneyExchangeTitle`)}</h2>
    <p class="mt-3 text-zinc-700">{t(`${k}.moneyExchangeBody`)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t(`${k}.mallTitle`)}</h2>
    <p class="mt-3 text-zinc-700">{t(`${k}.mallBody`)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t(`${k}.howToGetThereTitle`)}</h2>
    <p class="mt-3 text-zinc-700">{t(`${k}.howToGetThereBody`)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t(`${k}.busStationTitle`)}</h2>
    <p class="mt-3 text-zinc-700">{t(`${k}.busStationBody`)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-mekong-ink">{t(`${k}.vsNightTitle`)}</h2>
    <p class="mt-3 text-zinc-700">{t(`${k}.vsNightBody`)}</p>
  </section>

  <MapSection />

  <Reviews />

  <section id="faq">
    <h2 class="text-2xl font-bold text-mekong-ink">{t(`${k}.faqTitle`)}</h2>
    <div class="mt-4 space-y-4">
      {faqs.map((item) => (
        <div class="rounded-lg border border-zinc-200 bg-white p-4">
          <h3 class="font-semibold text-mekong-ink">{item.q}</h3>
          <p class="mt-2 text-zinc-700">{item.a}</p>
        </div>
      ))}
    </div>
  </section>

</div>
