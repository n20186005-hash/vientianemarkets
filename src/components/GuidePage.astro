---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { guides, guideSlugs, type GuideLang, type GuideSlug } from '../lib/guides';
import { guideExtra } from '../lib/guideExtras';
import { DOMAIN, useTranslations } from '../i18n/ui';
import { breadcrumbSchema } from '../lib/schema';

interface Props { lang: GuideLang; slug: GuideSlug }
const { lang, slug } = Astro.props;
const guide = guides[lang][slug];
const extra = guideExtra(lang, slug);
const base = lang === 'lo' ? '' : `/${lang}`;
const canonical = `${DOMAIN}${base}/guides/${slug}/`;
const alts = (['lo', 'en', 'zh', 'th'] as const).map(code => ({ hreflang: code === 'zh' ? 'zh-CN' : code, href: `${DOMAIN}${code === 'lo' ? '' : `/${code}`}/guides/${slug}/` }));
alts.push({ hreflang: 'x-default', href: `${DOMAIN}/guides/${slug}/` });
const t = useTranslations(lang);
const map = 'https://maps.app.goo.gl/2zP3kvc4hLKQ7q8V6';
const nightMap = 'https://maps.app.goo.gl/4opj9mpJvT2TJudD7';
const related = guideSlugs.filter(other => other !== slug);
const isComparison = slug === 'morning-vs-night-market';
const mainMap = isComparison ? nightMap : map;
const images = isComparison ? ['/gallery/talat-sao-1.jpg', '/gallery/night-market-1.jpg', '/gallery/night-market-2.jpg'] : ['/gallery/talat-sao-1.jpg', '/gallery/talat-sao-2.jpg', '/gallery/talat-sao-3.jpg'];
const basicValues = {
  en: [isComparison ? 'Talat Sao / Vientiane Night Market' : 'Talat Sao (ຕະຫຼາດເຊົ້າ)', isComparison ? 'Lane Xang Avenue / Chao Anouvong Park riverfront, Vientiane, Laos' : 'Lane Xang Avenue × Khu Vieng Road, Vientiane, Laos', 'Shopping market and retail', '60–90 minutes (suggested)', 'Browsing normally free; purchases extra', 'Talat Sao: daytime; night market: evening; check each shop'],
  zh: [isComparison ? '万象早市／湄公河夜市' : 'Talat Sao 万象早市', isComparison ? '万象 Lane Xang 大道／Chao Anouvong Park 河岸，老挝' : '老挝万象 Lane Xang 大道与 Khu Vieng 路交汇处', '购物市场及商场', '建议 60–90 分钟', '通常可免费逛市场，购物另付费', '早市白天、夜市傍晚；各店以现场为准'],
  th: [isComparison ? 'ตลาดเช้า / ตลาดกลางคืนเวียงจันทน์' : 'ตลาดเช้าเวียงจันทน์ Talat Sao', isComparison ? 'ถนนล้านช้าง / ริมโขงใกล้สวนเจ้าอนุวงศ์ เวียงจันทน์ ลาว' : 'แยกถนนล้านช้างกับถนนคูเวียง เวียงจันทน์ ลาว', 'ตลาดและร้านค้าปลีก', 'แนะนำ 60–90 นาที', 'โดยทั่วไปเดินชมฟรี ซื้อสินค้าแยกต่างหาก', 'ตลาดเช้าช่วงกลางวัน ตลาดกลางคืนช่วงเย็น ตรวจเวลาร้าน'],
  lo: [isComparison ? 'ຕະຫຼາດເຊົ້າ / ຕະຫຼາດກາງຄືນ' : 'ຕະຫຼາດເຊົ້າ', isComparison ? 'ຖະໜົນລ້ານຊ້າງ / ແຄມຂອງໃກ້ສວນເຈົ້າອານຸວົງ ວຽງຈັນ ລາວ' : 'ຖະໜົນລ້ານຊ້າງ ຕັດກັບຖະໜົນຄູວຽງ ວຽງຈັນ ລາວ', 'ຕະຫຼາດ ແລະ ຮ້ານຄ້າ', 'ແນະນຳ 60–90 ນາທີ', 'ໂດຍທົ່ວໄປເຂົ້າເບິ່ງຟຣີ ຊື້ສິນຄ້າແຍກ', 'ຕະຫຼາດເຊົ້າກາງເວັນ ຕະຫຼາດກາງຄືນຕອນແລງ'],
}[lang];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: guide.title, description: guide.intro, inLanguage: lang, mainEntityOfPage: canonical, dateModified: '2026-11-16', publisher: { '@type': 'Organization', name: 'Vientiane Markets Guide' } },
  breadcrumbSchema([{ name: t('nav.title'), url: `${DOMAIN}${base}/` }, { name: guide.title, url: canonical }], `${canonical}#breadcrumb`),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: extra.faq.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];
---
<Layout title={`${guide.title} | Vientiane Markets Guide`} description={guide.intro} canonical={canonical} alternates={alts} schema={schema}>
  <Header lang={lang} />
  <main>
    <nav aria-label="Breadcrumb" class="mx-auto max-w-5xl px-4 py-5 text-sm text-zinc-600"><a class="hover:underline" href={`${base}/`}>{t('nav.title')}</a> / <a class="hover:underline" href={`${base}/talat-sao/`}>Talat Sao</a> / {guide.title}</nav>
    <header class="bg-gradient-to-br from-mekong-blue to-mekong-teal text-white">
      <div class="mx-auto max-w-5xl px-4 py-14"><p class="text-sm tracking-wider text-mekong-gold">VIENTIANE MARKET GUIDE</p><h1 class="mt-3 max-w-4xl text-3xl font-bold sm:text-5xl">{guide.title}</h1><p class="mt-5 max-w-3xl text-lg text-white/90">{guide.intro}</p><a href={mainMap} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-lg bg-mekong-gold px-5 py-3 font-semibold text-mekong-ink">Google Maps ↗</a></div>
    </header>
    <section class="mx-auto max-w-5xl px-4 pt-10" aria-label="Market photo"><img src={images[0]} alt={isComparison ? 'Talat Sao Morning Market building in Vientiane' : 'Talat Sao market exterior on Lane Xang Avenue, Vientiane'} width="1200" height="680" loading="eager" class="max-h-[420px] w-full rounded-2xl object-cover" /></section>
    <section class="mx-auto max-w-5xl px-4 pt-10" id="about-management"><div class="rounded-2xl border border-zinc-200 bg-white p-7 shadow-sm"><h2 class="text-2xl font-bold text-mekong-ink">{extra.aboutTitle}</h2><p class="mt-4 leading-8 text-zinc-700">{extra.about}</p></div></section>
    <div class="mx-auto max-w-5xl px-4 py-12">
      <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_16rem]">
        <article class="space-y-9">
          <section><h2 class="text-2xl font-bold text-mekong-ink">{extra.basicTitle}</h2><dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 rounded-xl bg-white p-5 text-sm">{extra.labels.map((label, i) => <><dt class="font-semibold text-zinc-600">{label}</dt><dd class="text-zinc-800">{basicValues[i]}</dd></>)}</dl></section>
          <section><h2 class="text-2xl font-bold text-mekong-ink">{extra.visitTitle}</h2><p class="mt-3 leading-8 text-zinc-700">{extra.visit}</p></section>
          {guide.sections.map((section, i) => <section id={`section-${i + 1}`}><h2 class="text-2xl font-bold text-mekong-ink">{section.heading}</h2><p class="mt-3 leading-8 text-zinc-700">{section.body}</p></section>)}
          <section><h2 class="text-2xl font-bold text-mekong-ink">{extra.historyTitle}</h2><p class="mt-3 leading-8 text-zinc-700">{extra.history}</p></section>
          <section><h2 class="text-2xl font-bold text-mekong-ink">{extra.architectureTitle}</h2><p class="mt-3 leading-8 text-zinc-700">{extra.architecture}</p></section>
          <section><h2 class="text-2xl font-bold text-mekong-ink">{extra.routeTitle}</h2><ol class="mt-4 space-y-3">{extra.route.map((step, i) => <li class="flex gap-4"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-mekong-blue text-sm font-bold text-white">{i + 1}</span><p class="pt-1 text-zinc-700">{step}</p></li>)}</ol></section>
          <section><h2 class="text-2xl font-bold text-mekong-ink">{extra.photosTitle}</h2><p class="mt-3 text-zinc-700">{extra.photos}</p><div class="mt-5 grid gap-4 sm:grid-cols-2">{images.slice(1).map((src, i) => <img src={src} alt={isComparison ? (i === 0 ? 'Vientiane Night Market riverside scene' : 'Vientiane Night Market stalls and surroundings') : (i === 0 ? 'Talat Sao market shopping area' : 'Talat Sao stalls and building details')} loading="lazy" width="600" height="420" class="h-52 w-full rounded-xl object-cover" />)}</div></section>
          <section class="rounded-2xl bg-zinc-100 p-6"><h2 class="text-xl font-bold text-mekong-ink">{t('markets.talatSao.name')}</h2><p class="mt-2 text-zinc-700">Lane Xang Avenue · Vientiane, Laos</p><div class="mt-4 flex flex-wrap gap-3"><a href={map} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-mekong-blue px-4 py-2 font-semibold text-white">Google Maps · Talat Sao ↗</a><a href={nightMap} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-mekong-blue px-4 py-2 font-semibold text-mekong-blue">Google Maps · Night Market ↗</a></div></section>
          <section><h2 class="text-2xl font-bold text-mekong-ink">{extra.faqTitle}</h2><div class="mt-4 space-y-4">{extra.faq.map(item => <div class="rounded-xl border border-zinc-200 p-5"><h3 class="font-semibold text-mekong-ink">{item.q}</h3><p class="mt-2 text-zinc-700">{item.a}</p></div>)}</div></section>
          <section><h2 class="text-2xl font-bold text-mekong-ink">{extra.nearbyTitle}</h2><div class="mt-4 grid gap-3 sm:grid-cols-2"><a class="rounded-xl border p-4 text-mekong-blue hover:underline" href={`${base}/talat-sao/`}>Talat Sao · {t('markets.talatSao.name')}</a><a class="rounded-xl border p-4 text-mekong-blue hover:underline" href={`${base}/vientiane-night-market/`}>Mekong · {t('markets.nightMarket.name')}</a>{related.map(other => <a class="rounded-xl border p-4 text-mekong-blue hover:underline" href={`${base}/guides/${other}/`}>{guides[lang][other].title}</a>)}</div><p class="mt-4 text-sm text-zinc-600">Patuxai · Lane Xang Avenue · <a href="https://www.patuxai.com/" class="text-mekong-blue underline">Patuxai visitor guide</a></p></section>
          <section class="border-t border-zinc-200 pt-6 text-sm text-zinc-600"><h2 class="text-lg font-semibold text-mekong-ink">{extra.sourceTitle}</h2><ul class="mt-3 list-disc space-y-1 pl-5"><li><a class="underline" href="https://www.tourismlaos.org/central-provinces/vientiane-capital/">Tourism Laos — Vientiane Capital</a></li><li><a class="underline" href={map}>Google Maps — Talat Sao</a></li><li><a class="underline" href={nightMap}>Google Maps — Vientiane Night Market</a></li></ul><p class="mt-3">Source review: 2026-11-16. Operating hours and prices should be checked on site.</p></section>
        </article>
        <aside class="h-fit rounded-2xl border border-zinc-200 bg-white p-5"><h2 class="text-lg font-bold text-mekong-ink">{t('nav.markets')}</h2><ul class="mt-4 space-y-4 text-sm"><li><a class="text-mekong-blue hover:underline" href={`${base}/talat-sao/`}>{t('markets.talatSao.name')}</a></li><li><a class="text-mekong-blue hover:underline" href={`${base}/vientiane-night-market/`}>{t('markets.nightMarket.name')}</a></li>{related.map(other => <li><a class="text-mekong-blue hover:underline" href={`${base}/guides/${other}/`}>{guides[lang][other].title}</a></li>)}</ul></aside>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
