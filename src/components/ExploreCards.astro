---
import { useTranslations } from '../i18n/ui';
import { guideSlugs, guides } from '../lib/guides';
import { nearbySlugs, nearby } from '../lib/nearby';

interface Props {
  lang: 'lo' | 'en' | 'zh' | 'th';
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'lo' ? '' : `/${lang}`;
const tsHref = `${base}/talat-sao/`;
const nmHref = `${base}/vientiane-night-market/`;
---

<section id="explore" class="bg-zinc-100 py-12">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid gap-6 sm:grid-cols-2">
      <a href={tsHref} class="group block rounded-2xl border border-zinc-200 bg-white p-6 transition hover:border-mekong-blue">
        <h3 class="text-xl font-bold text-mekong-ink">{t('markets.talatSao.name')}</h3>
        <p class="mt-2 text-sm text-zinc-600">{t('markets.talatSao.desc1')} · {t('markets.talatSao.rating')}</p>
        <span class="mt-4 inline-block font-semibold text-mekong-blue group-hover:underline">{t('markets.talatSao.name')} →</span>
      </a>
      <a href={nmHref} class="group block rounded-2xl border border-zinc-200 bg-white p-6 transition hover:border-mekong-blue">
        <h3 class="text-xl font-bold text-mekong-ink">{t('markets.nightMarket.name')}</h3>
        <p class="mt-2 text-sm text-zinc-600">{t('markets.nightMarket.desc1')} · {t('markets.nightMarket.rating')}</p>
        <span class="mt-4 inline-block font-semibold text-mekong-blue group-hover:underline">{t('markets.nightMarket.name')} →</span>
      </a>
    </div>
  </div>
</section>
<section class="bg-zinc-50 py-12" aria-label="Nearby visits">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-2xl font-bold text-mekong-ink">{lang === 'zh' ? '周边游览与市场路线' : lang === 'th' ? 'เที่ยวใกล้ตลาดและเส้นทางแนะนำ' : lang === 'lo' ? 'ທ່ຽວໃກ້ຕະຫຼາດ ແລະ ເສັ້ນທາງ' : 'Nearby visits and market routes'}</h2>
    <p class="mt-2 text-zinc-600">{lang === 'zh' ? '从市中心早市出发，结合交通攻略与傍晚的湄公河夜市。' : lang === 'th' ? 'เริ่มจากตลาดเช้ากลางเมือง แล้วใช้คู่มือเดินทางต่อไปตลาดริมโขงตอนเย็น' : lang === 'lo' ? 'ເລີ່ມຈາກຕະຫຼາດເຊົ້າ ແລະ ໄປຕະຫຼາດແຄມຂອງຕອນແລງ' : 'Start with central Talat Sao, then plan an evening visit to the Mekong riverfront.'}</p>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      <a class="rounded-xl border bg-white p-5 text-mekong-blue hover:border-mekong-blue" href={`${base}/guides/talat-sao-transport/`}>{guides[lang]['talat-sao-transport'].title} →</a>
      <a class="rounded-xl border bg-white p-5 text-mekong-blue hover:border-mekong-blue" href={`${base}/guides/morning-vs-night-market/`}>{guides[lang]['morning-vs-night-market'].title} →</a>
      <a class="rounded-xl border bg-white p-5 text-mekong-blue hover:border-mekong-blue" href={nmHref}>{t('markets.nightMarket.name')} →</a>
    </div>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      {[...nearbySlugs.slice(0,3), ...nearbySlugs.slice(-3)].map(slug => <a class="rounded-xl border bg-white p-5 hover:border-mekong-blue" href={`${base}/nearby/${slug}/`}><h3 class="font-semibold text-mekong-ink">{nearby[slug].details[lang].title}</h3><p class="mt-2 text-sm text-zinc-600">{nearby[slug].details[lang].subtitle}</p><span class="mt-3 inline-block text-sm font-semibold text-mekong-blue">→</span></a>)}
    </div>
    <a class="mt-6 inline-block rounded-lg bg-mekong-blue px-5 py-3 font-semibold text-white" href={`${base}/nearby/`}>{lang === 'zh' ? `查看全部 ${nearbySlugs.length} 个周边景点` : lang === 'th' ? `ดูสถานที่เที่ยวทั้งหมด ${nearbySlugs.length} แห่ง` : lang === 'lo' ? `ເບິ່ງສະຖານທີ່ທັງໝົດ ${nearbySlugs.length} ແຫ່ງ` : `Explore all ${nearbySlugs.length} nearby places`} →</a>
  </div>
</section>
<section class="bg-white py-12" aria-label="Market guides">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-2xl font-bold text-mekong-ink">{lang === 'zh' ? '万象市场实用攻略' : lang === 'th' ? 'คู่มือเที่ยวตลาดเวียงจันทน์' : lang === 'lo' ? 'ຄູ່ມືທ່ຽວຕະຫຼາດວຽງຈັນ' : 'Vientiane market guides'}</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {guideSlugs.map(slug => <a href={`${base}/guides/${slug}/`} class="rounded-xl border border-zinc-200 p-5 hover:border-mekong-blue"><h3 class="font-semibold text-mekong-ink">{guides[lang][slug].title}</h3><p class="mt-2 text-sm text-zinc-600">{guides[lang][slug].intro}</p></a>)}
    </div>
  </div>
</section>
