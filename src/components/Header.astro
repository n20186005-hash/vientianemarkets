---
import LanguagePicker from './LanguagePicker.tsx';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  lang?: 'lo' | 'en' | 'zh';
}
const { lang: langProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = lang === 'lo' ? '/' : `/${lang}/`;
---

<header class="sticky top-0 z-50 border-b border-zinc-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href={home} class="flex items-center gap-2 font-bold text-mekong-ink">
      <span class="text-mekong-gold">ຕະຫຼາດ</span>
      <span class="hidden sm:inline">Vientiane Markets Guide</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm font-medium text-zinc-700 md:flex">
      <a href={`${home}#market-core`} class="hover:text-mekong-blue">{t('nav.markets')}</a>
      <a href={`${home}#map`} class="hover:text-mekong-blue">{t('nav.map')}</a>
      <a href={`${home}#faq`} class="hover:text-mekong-blue">{t('nav.faq')}</a>
      <a href={t('footer.privacyUrl')} class="hover:text-mekong-blue">{t('nav.privacy')}</a>
    </nav>
    <LanguagePicker client:load lang={lang} path={Astro.url.pathname} />
  </div>
</header>
