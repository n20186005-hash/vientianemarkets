---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  lang?: 'lo' | 'en' | 'zh';
}
const { lang: langProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-mekong-ink text-zinc-300">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2 font-bold text-white">
          <span class="text-mekong-gold">ຕະຫຼາດ</span>
          <span>Vientiane Markets Guide</span>
        </div>
        <p class="mt-3 text-sm text-zinc-400">{t('footer.tagline')}</p>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-200">{t('footer.explore')}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/talat-sao/" class="hover:text-mekong-gold">Talat Sao</a></li>
          <li><a href="/vientiane-night-market/" class="hover:text-mekong-gold">Vientiane Night Market</a></li>
          <li><a href={lang === 'lo' ? '/en/' : `/${lang}/`} class="hover:text-mekong-gold">{t('nav.markets')}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-200">{t('footer.legal')}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={t('footer.privacyUrl')} class="hover:text-mekong-gold">{t('footer.privacy')}</a></li>
          <li><a href={t('footer.termsUrl')} class="hover:text-mekong-gold">{t('footer.terms')}</a></li>
          <li><a href={t('footer.cookieUrl')} class="hover:text-mekong-gold">{t('footer.cookie')}</a></li>
        </ul>
      </div>
    </div>
    <p class="mt-8 border-t border-zinc-700 pt-6 text-sm text-zinc-400">{t('footer.copyright')}</p>
  </div>
</footer>
