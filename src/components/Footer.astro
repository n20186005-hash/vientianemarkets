---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  lang?: 'lo' | 'en' | 'zh' | 'th';
}
const { lang: langProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'lo' ? '' : `/${lang}`;
const legalBase = lang === 'lo' ? '/lo' : `/${lang}`;
const copyright = {
  zh: '© 2026 永珍早市 & 永珍夜市 · 版權所有',
  en: '© 2026 Talat Sao & Vientiane Night Market · All rights reserved',
  th: '© 2026 ตลาดเช้าและตลาดกลางคืนเวียงจันทน์ · สงวนลิขสิทธิ์',
  lo: '© 2026 ຕະຫຼາດເຊົ້າ ແລະ ຕະຫຼາດກາງຄືນວຽງຈັນ · ສະຫງວນລິຂະສິດ',
}[lang];
const independence = {
  zh: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。',
  en: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.',
  th: 'เว็บไซต์นี้เป็นโครงการข้อมูลท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐหรือองค์กรทางการใด ๆ',
  lo: 'ເວັບໄຊນີ້ເປັນໂຄງການຂໍ້ມູນທ່ອງທ່ຽວອິດສະລະ. ບໍ່ມີຄວາມກ່ຽວຂ້ອງກັບໜ່ວຍງານລັດ ຫຼື ອົງການທາງການ.',
}[lang];
const sourcesLabel = {zh:'资料来源',en:'Sources',th:'แหล่งข้อมูล',lo:'ແຫຼ່ງຂໍ້ມູນ'}[lang];
---

<footer class="bg-mekong-ink text-zinc-300">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="space-y-2 text-sm text-zinc-300">
        <p>{copyright}</p>
        <p>{independence}</p>
      </div>
      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm md:justify-end" aria-label={t('footer.legalTitle')}>
        <a href={`${base}/sources/`} class="hover:text-mekong-gold">{sourcesLabel}</a>
        <a href={`${legalBase}/privacy-policy`} class="hover:text-mekong-gold">{t('footer.privacy')}</a>
        <a href={`${legalBase}/terms-of-service`} class="hover:text-mekong-gold">{t('footer.terms')}</a>
        <a href={`${legalBase}/cookie-settings`} class="hover:text-mekong-gold">{t('footer.cookie')}</a>
      </nav>
    </div>
  </div>
</footer>
