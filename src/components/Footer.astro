---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  lang?: 'lo' | 'en' | 'zh' | 'th';
}
const { lang: langProp } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === 'lo' ? '' : `/${lang}`;
const legalBase = lang === 'lo' ? '/lo' : `/${lang}`;
---

<footer class="bg-mekong-ink text-zinc-300">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2 font-bold text-white">
          <span class="text-mekong-gold">ຕະຫຼາດ</span>
          <span>Vientiane Markets Guide</span>
        </div>
        <p class="mt-3 text-sm text-zinc-400">{t('footer.aboutText1')}</p>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-200">{t('nav.markets')}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={`${base}/talat-sao/`} class="hover:text-mekong-gold">{t('markets.talatSao.name')}</a></li>
          <li><a href={`${base}/vientiane-night-market/`} class="hover:text-mekong-gold">{t('markets.nightMarket.name')}</a></li>
          <li><a href={lang === 'lo' ? '/' : `/${lang}/`} class="hover:text-mekong-gold">{t('nav.title')}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-200">{t('footer.legalTitle')}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={`${legalBase}/privacy`} class="hover:text-mekong-gold">{t('footer.privacy')}</a></li>
          <li><a href={`${legalBase}/terms`} class="hover:text-mekong-gold">{t('footer.terms')}</a></li>
          <li><a href={`${legalBase}/cookie-settings`} class="hover:text-mekong-gold">{t('footer.cookie')}</a></li>
        </ul>
      </div>
    </div>
    <p class="mt-8 border-t border-zinc-700 pt-6 text-sm text-zinc-400">{t('footer.copyright')}</p>
  </div>
</footer>
