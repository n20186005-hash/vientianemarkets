---
import GuidePage from '../../../components/GuidePage.astro';
import { guideSlugs } from '../../../lib/guides';
export function getStaticPaths() { return (['en', 'zh', 'th'] as const).flatMap(lang => guideSlugs.map(slug => ({ params: { lang, slug } }))); }
const { lang, slug } = Astro.params;
---
<GuidePage lang={lang as 'en' | 'zh' | 'th'} slug={slug as (typeof guideSlugs)[number]} />
