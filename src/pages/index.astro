---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MarketCore from '../components/MarketCore.astro';
import ExploreCards from '../components/ExploreCards.astro';
import MapSection from '../components/MapSection.astro';
import CultureGuide from '../components/CultureGuide.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, pageAlternates, DOMAIN } from '../i18n/ui';
import { webSiteSchema, webPageSchema, breadcrumbSchema } from '../lib/schema';

const lang = 'lo';
const t = useTranslations(lang);
const homeUrl = `${DOMAIN}/`;
const schema = [
  webSiteSchema(),
  webPageSchema(homeUrl, t('seo.home.title'), t('seo.home.description'), lang),
  breadcrumbSchema([{ name: t('nav.title'), url: homeUrl }], `${homeUrl}#breadcrumb`),
];
---

<Layout
  title={t('seo.home.title')}
  description={t('seo.home.description')}
  alternates={pageAlternates('')}
  schema={schema}
>
  <Header lang={lang} />
  <Hero />
  <MarketCore />
  <ExploreCards lang={lang} />
  <MapSection />
  <CultureGuide />
  <Footer lang={lang} />
</Layout>
