---
import { getLangFromUrl } from '../i18n/ui';
import '../styles/global.css';

interface Alternate {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonical?: string;
  alternates?: Alternate[];
}

const { title, description, noindex = false, alternates } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const DOMAIN = 'https://www.vientianemarkets.com';
// Canonical is always the www + https + trailing-slash variant.
const canonical = Astro.props.canonical ?? `${DOMAIN}${Astro.url.pathname}`;

// Default hreflang alternates (used only if a page doesn't pass its own).
function defaultAlternates(pathname: string): Alternate[] {
  const clean = pathname.replace(/^\/(en|zh|lo|th)\//, '/').replace(/^\/(en|zh|lo|th)$/, '/');
  const lo = clean === '/' ? '/' : `/lo${clean}`;
  return [
    { hreflang: 'lo', href: `${DOMAIN}${lo}` },
    { hreflang: 'en', href: `${DOMAIN}/en${clean}` },
    { hreflang: 'zh-CN', href: `${DOMAIN}/zh${clean}` },
    { hreflang: 'th', href: `${DOMAIN}/th${clean}` },
    { hreflang: 'x-default', href: `${DOMAIN}${lo}` },
  ];
}
const alts = alternates ?? defaultAlternates(Astro.url.pathname);

const ogLocale = lang === 'lo' ? 'lo_LA' : lang === 'zh' ? 'zh_CN' : lang === 'th' ? 'th_TH' : 'en_US';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />

    {alts.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vientiane Markets Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {alts.filter((a) => a.hreflang !== 'x-default').map((a) => (
      <meta property="og:locale:alternate" content={a.hreflang === 'zh-CN' ? 'zh_CN' : a.hreflang === 'lo' ? 'lo_LA' : 'en_US'} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Lao:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body class="bg-zinc-50 text-zinc-900 font-sans antialiased selection:bg-mekong-blue selection:text-white leading-relaxed">
    <slot />
  </body>
</html>
